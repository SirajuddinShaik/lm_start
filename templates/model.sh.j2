#!/bin/bash
#
# Management script for {{ model_id }}
# Generated by lm_start

MODEL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MODEL_NAME="{{ model_name }}"
VENV_PATH="$MODEL_DIR/.venv"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_ok() { echo -e "${GREEN}[OK]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

check_venv() {
    if [ ! -d "$VENV_PATH" ]; then
        log_error "Virtual environment not found at $VENV_PATH"
        exit 1
    fi
    source "$VENV_PATH/bin/activate"
}

cmd_start() {
    log_info "Starting {{ model_id }}..."
    cd "$MODEL_DIR" && pm2 start ecosystem.config.js
    log_ok "Server started. Check status with: $0 status"
}

cmd_stop() {
    log_info "Stopping {{ model_id }}..."
    cd "$MODEL_DIR" && pm2 stop ecosystem.config.js
    log_ok "Server stopped"
}

cmd_restart() {
    log_info "Restarting {{ model_id }}..."
    cd "$MODEL_DIR" && pm2 restart ecosystem.config.js
    log_ok "Server restarted"
}

cmd_status() {
    pm2 status
}

cmd_logs() {
    pm2 logs {{ model_name }}
}

cmd_errors() {
    pm2 logs {{ model_name }} --err
}

cmd_health() {
    curl -s http://localhost:{{ vllm_config.port }}/health | jq . 2>/dev/null || curl -s http://localhost:{{ vllm_config.port }}/health
}

cmd_url() {
    echo "Server URL: http://localhost:{{ vllm_config.port }}"
    echo "API: http://localhost:{{ vllm_config.port }}/v1"
    echo ""
    echo "Test commands:"
    echo "  curl http://localhost:{{ vllm_config.port }}/v1/models"
}

cmd_activate() {
    echo "source $VENV_PATH/bin/activate"
    echo "cd $MODEL_DIR"
}

cmd_info() {
    echo "Model: {{ model_id }}"
    echo "Port: {{ vllm_config.port }}"
    echo "Directory: $MODEL_DIR"
}

# Main
case "${1:-}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    logs)
        cmd_logs
        ;;
    errors)
        cmd_errors
        ;;
    health)
        cmd_health
        ;;
    url)
        cmd_url
        ;;
    activate)
        cmd_activate
        ;;
    info)
        cmd_info
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs|errors|health|url|activate|info}"
        exit 1
        ;;
esac
